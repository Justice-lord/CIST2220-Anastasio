<Window x:Class="Q4Anastasio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Q4Anastasio"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Label Content="Welcome to the Energy Educator.&#10;Select a fuel type and click Get Info." 
               HorizontalAlignment="Center"
               Grid.Row="0"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               FontSize="24"
               FontWeight="Bold"/>

        <StackPanel Grid.Row="1"
                    Grid.Column="0"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="200"
                    Height="100">
            
            <RadioButton x:Name="rbGasoline" 
                         Content="Gasoline"
                         Margin="10"/>
            
            <RadioButton x:Name="rbEthanol" 
                         Content="Ethanol"
                         Margin="10"/>
            
            <RadioButton x:Name="rbMethanol" 
                         Content="Methanol"
                         Margin="10"/>
        </StackPanel>

        <Button x:Name="btnGetInfo" 
                Content="Get Info" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Grid.Row="1"
                Grid.Column="1"
                Click="btnGetInfo_Click"
                Height="50"
                Width="200"/>

        <TextBox x:Name="tbxSummary"
                 Grid.Row="3"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 IsReadOnly="True"/>
    </Grid>
</Window>
