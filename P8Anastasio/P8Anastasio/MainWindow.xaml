<Window x:Class="P8Anastasio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:P8Anastasio"
        mc:Ignorable="d"
        Title="Flash Cards" Height="450" Width="800">
    <Grid>
        <TabControl x:Name="tabMain"
                    SelectionChanged="tabMain_SelectionChanged">
            <TabItem Header="Flash Cards">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label x:Name="lblCardID" 
                           Content="CardID"
                           Grid.Row="0"
                           Grid.Column="0"/>
                    
                    <TextBox x:Name="tbxTitle"
                             IsReadOnly="True"
                             Grid.Row="0"
                             Grid.Column="1"
                             Grid.ColumnSpan="3"/>
                    
                    <Label Content="Question"
                           VerticalAlignment="Center"
                           Grid.Row="1"
                           Grid.Column="0"/>

                    <TextBox x:Name="tbxQuestion"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Grid.Row="2"
                             Grid.Column="0"
                             Grid.ColumnSpan="4"/>

                    <Button x:Name="btnShowAnswer"
                            Content="Show Answer"
                            Click="btnShowAnswer_Click"
                            Margin="5"
                            Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"/>

                    <Label Content="Answer"
                           VerticalAlignment="Center"
                           Grid.Row="4"
                           Grid.Column="0"/>

                    <TextBox x:Name="tbxAnswers"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Grid.Row="5"
                             Grid.Column="0"
                             Grid.ColumnSpan="4"/>

                    <Button x:Name="btnRight"
                            Content="Right"
                            Click="btnRight_Click"
                            Margin="5"
                            Grid.Row="6"
                            Grid.Column="1"/>

                    <Button x:Name="btnWrong"
                            Content="Wrong"
                            Click="btnWrong_Click"
                            Margin="5"
                            Grid.Row="6"
                            Grid.Column="2"/>

                    <TextBox x:Name="tbxRules"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Grid.Row="7"
                             Grid.Column="0"
                             Grid.ColumnSpan="4"/>
                </Grid>
            </TabItem>
            <TabItem Header="Manage Cards">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label x:Name="lblmCardID"
                           Content="CardID"
                           Grid.Row="0"
                           Grid.Column="0"/>

                    <ListBox x:Name="lbxmCards"
                             MouseDoubleClick="lbxmCards_MouseDoubleClick"
                             Margin="5"
                             Grid.Row="0"
                             Grid.Column="1"
                             Grid.RowSpan="7"/>

                    <Label Content="Title"
                           Grid.Row="1"
                           Grid.Column="0"/>

                    <TextBox x:Name="tbxmTitle"
                             Grid.Row="2"
                             Grid.Column="0"/>

                    <Label Content="Question"
                           Grid.Row="3"
                           Grid.Column="0"/>

                    <TextBox x:Name="tbxmQuestion"
                             TextWrapping="Wrap"
                             Grid.Row="4"
                             Grid.Column="0"/>

                    <Label Content="Answer"
                           Grid.Row="5"
                           Grid.Column="0"/>

                    <TextBox x:Name="tbxmAnswer"
                             TextWrapping="Wrap"
                             Grid.Row="6"
                             Grid.Column="0"/>

                    <StackPanel Orientation="Horizontal"
                                Grid.Row="7"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Center">
                        <Button x:Name="btnmAdd"
                                Content="Add"
                                Click="btnmAdd_Click"
                                Width="75"
                                Height="30"
                                Margin="5"/>

                        <Button x:Name="btnmUpdate"
                                Content="Update"
                                Click="btnmUpdate_Click"
                                Width="75"
                                Height="30"
                                Margin="5"/>

                        <Button x:Name="btnmRemove"
                                Content="Remove"
                                Click="btnmRemove_Click"
                                Width="75"
                                Height="30"
                                Margin="5"/>
                    </StackPanel>

                    <TextBox x:Name="tbxmRules"
                             TextWrapping="Wrap"
                             Grid.Row="8"
                             Grid.Column="0"
                             Grid.ColumnSpan="2"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
